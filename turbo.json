{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "env": [
        "HARPOC_REQUIRE_PLATFORM_TESTS",
        "HARPOC_TEST_KEYCHAIN",
        "HARPOC_SERIES_FILE",
        "HARPOC_TWO_UID_VAULT_USER",
        "HARPOC_TWO_UID_AGENT_USER"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
