{
  "name": "@harpoc/e2e",
  "version": "1.0.0",
  "description": "End-to-end evaluation harness: live backends, real surfaces, evidence emission",
  "license": "BUSL-1.1",
  "author": "Stefan Gönitzer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@harpoc/shared": "workspace:*",
    "@harpoc/core": "workspace:*",
    "@harpoc/mcp-server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "scripts": {
    "pki": "node scripts/generate-fixtures.mjs pki",
    "keys": "node scripts/generate-fixtures.mjs keys",
    "repos": "node scripts/generate-fixtures.mjs repos",
    "fleet:up": "node scripts/fleet-preflight.mjs && pnpm pki && pnpm keys && pnpm repos && docker compose up -d --wait --build",
    "fleet:down": "docker compose down -v",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run"
  }
}
