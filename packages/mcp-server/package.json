{
  "name": "@harpoc/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for zero-knowledge secret access by AI agents",
  "license": "BUSL-1.1",
  "author": "Stefan Gönitzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarpocGH/harpoc.git",
    "directory": "packages/mcp-server"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "type": "module",
  "bin": {
    "harpoc-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@harpoc/cert-manager": "workspace:*",
    "@harpoc/core": "workspace:*",
    "@harpoc/oauth-proxy": "workspace:*",
    "@harpoc/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@harpoc/test-utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src/"
  }
}
