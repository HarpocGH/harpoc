{
  "name": "@harpoc/rest-api",
  "version": "1.5.0",
  "description": "REST API for Harpoc — JWT auth, rate limiting, audit middleware",
  "license": "BUSL-1.1",
  "author": "Stefan Gönitzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarpocGH/harpoc.git",
    "directory": "packages/rest-api"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@harpoc/cert-manager": "workspace:*",
    "@harpoc/core": "workspace:*",
    "@harpoc/oauth-proxy": "workspace:*",
    "@harpoc/shared": "workspace:*",
    "@hono/node-server": "^1.19.15",
    "hono": "^4.13.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@harpoc/test-utils": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src/"
  }
}
