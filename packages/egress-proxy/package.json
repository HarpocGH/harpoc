{
  "name": "@harpoc/egress-proxy",
  "version": "1.5.0",
  "description": "Egress credential proxy (placeholder swap at the egress hop: plain-HTTP rewrite mode and CONNECT with a Harpoc CA) for Harpoc",
  "license": "BUSL-1.1",
  "author": "Stefan Gönitzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarpocGH/harpoc.git",
    "directory": "packages/egress-proxy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@harpoc/cert-manager": "workspace:*",
    "@harpoc/core": "workspace:*",
    "@harpoc/shared": "workspace:*",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@harpoc/test-utils": "workspace:*",
    "@types/node": "^26.6.4"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src/"
  }
}
