{
  "name": "@harpoc/sdk",
  "version": "1.5.0",
  "description": "TypeScript SDK for Harpoc — direct and REST client modes",
  "license": "BUSL-1.1",
  "author": "Stefan Gönitzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarpocGH/harpoc.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@harpoc/shared": "workspace:*"
  },
  "devDependencies": {
    "@harpoc/core": "workspace:*",
    "@harpoc/oauth-proxy": "workspace:*",
    "@harpoc/cert-manager": "workspace:*",
    "@harpoc/test-utils": "workspace:*"
  },
  "peerDependencies": {
    "@harpoc/core": "^1.5.0",
    "@harpoc/oauth-proxy": "^1.5.0",
    "@harpoc/cert-manager": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@harpoc/core": {
      "optional": true
    },
    "@harpoc/oauth-proxy": {
      "optional": true
    },
    "@harpoc/cert-manager": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint src/"
  }
}
