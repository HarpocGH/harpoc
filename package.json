{
  "name": "harpoc",
  "version": "1.5.0",
  "description": "Zero-knowledge secret management for AI agents",
  "author": "Stefan Gönitzer",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarpocGH/harpoc.git"
  },
  "bugs": {
    "url": "https://github.com/HarpocGH/harpoc/issues"
  },
  "homepage": "https://github.com/HarpocGH/harpoc#readme",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 exec vitest run --coverage",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.9.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
